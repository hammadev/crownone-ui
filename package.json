{
  "name": "@crownone/ui",
  "version": "0.1.1",
  "description": "Crown One shared UI component library for React Native / Expo",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "types": "./lib/typescript/index.d.ts"
    }
  },
  "source": "src/index.ts",
  "files": [
    "lib",
    "src",
    "!**/__tests__",
    "!**/*.spec.*",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "bob build",
    "prepare": "bob build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "expo",
    "ui",
    "components"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hammadev/crownone-ui.git"
  },
  "homepage": "https://github.com/hammadev/crownone-ui#readme",
  "bugs": {
    "url": "https://github.com/hammadev/crownone-ui/issues"
  },
  "peerDependencies": {
    "@expo/vector-icons": ">=13",
    "expo-blur": ">=13",
    "expo-image": ">=1",
    "expo-linear-gradient": ">=13",
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-reanimated": ">=3",
    "react-native-safe-area-context": ">=4",
    "react-native-size-matters": ">=0.4"
  },
  "devDependencies": {
    "react-native-builder-bob": "^0.37.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.3.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
